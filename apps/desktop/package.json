{
  "name": "@showflow/desktop",
  "productName": "Showflow",
  "version": "0.0.0",
  "private": true,
  "description": "Showflow desktop application.",
  "license": "UNLICENSED",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "build": "electron-forge package",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test:security": "node --test --experimental-strip-types src/main/security.test.mts",
    "test:ipc": "node --test --experimental-strip-types ../../packages/contracts/src/app-runtime.test.mts src/main/runtime-info-handler.test.mts src/preload/api.test.mts"
  },
  "config": {
    "forge": "./forge.config.ts"
  },
  "dependencies": {
    "@showflow/contracts": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "typescript": "5.9.3",
    "vite": "8.2.0"
  }
}

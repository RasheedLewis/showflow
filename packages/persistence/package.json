{
  "name": "@showflow/persistence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Showflow persistence adapters, migrations, and row mapping.",
  "exports": {
    ".": "./src/index.ts",
    "./backup": "./src/backup/index.mts",
    "./database": "./src/database/database-service.mts",
    "./migrations": "./src/migrations/index.mts",
    "./settings": "./src/settings/index.mts",
    "./studios": "./src/studios/index.mts",
    "./spikes/node-sqlite": "./src/spikes/node-sqlite-spike.mts",
    "./spikes/node-sqlite-report": "./src/spikes/node-sqlite-spike-report.mts",
    "./testing": "./src/testing/create-test-database.mts"
  },
  "dependencies": {
    "@showflow/application": "workspace:*",
    "@showflow/domain": "workspace:*",
    "zod": "4.4.3"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
